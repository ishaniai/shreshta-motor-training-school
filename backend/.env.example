PORT=3000
NODE_ENV=development

# Supabase — use service_role for server-side inserts (never expose to mobile)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT for login sessions (use a long random string in production)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Optional: comma-separated origins for CORS (default allows all in development)
CORS_ORIGINS=

# --- Registration email (Resend recommended) ---
EMAIL_NOTIFICATIONS_ENABLED=true
EMAIL_PROVIDER=resend
NOTIFY_EMAIL_TO=sumitdubey182019@gmail.com
EMAIL_FROM=Shreshta Motor Training <onboarding@resend.dev>

# Resend: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key

# SMTP fallback (Nodemailer) — set EMAIL_PROVIDER=smtp to use only SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# --- Registration WhatsApp (Twilio) ---
WHATSAPP_NOTIFICATIONS_ENABLED=true
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
# Sandbox sender (join via Twilio Console) or your approved WhatsApp sender
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
NOTIFY_WHATSAPP_TO=whatsapp:+917017898615
